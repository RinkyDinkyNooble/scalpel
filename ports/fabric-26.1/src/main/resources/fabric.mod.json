{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "scalpel.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.rinkynooble.scalpel.fabric.ScalpelFabric"],
    "client": ["com.rinkynooble.scalpel.fabric.ScalpelFabricClient"],
    "jei_mod_plugin": ["com.rinkynooble.scalpel.common.compat.ScalpelJeiPlugin"],
    "jade": ["com.rinkynooble.scalpel.common.compat.ScalpelJadePlugin"]
  },
  "mixins": [
    "scalpel.mixins.json",
    "scalpel.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_min}",
    "minecraft": "${minecraft_range}",
    "fabric-api": "*",
    "java": ">=25"
  }
}
